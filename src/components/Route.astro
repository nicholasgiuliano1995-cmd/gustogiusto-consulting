---
import type { Locale } from '../i18n';
import { getDict } from '../i18n';

interface Props {
  locale: Locale;
}

const t = getDict(Astro.props.locale);
---

<section id="metodo" class="bg-navy">
  <div class="mx-auto max-w-7xl px-5 pt-24 sm:px-8 lg:pt-32">
    <div class="max-w-2xl" data-reveal>
      <p class="eyebrow">{t.route.eyebrow}</p>
      <h2 class="mt-5 font-display font-semibold leading-tight text-cream" style="font-size: clamp(2rem, 4vw, 3.25rem);">
        {t.route.title}
      </h2>
      <p class="mt-6 text-base leading-relaxed text-cream/70 sm:text-lg">{t.route.intro}</p>
    </div>
  </div>

  {/* The route: one continuous vertical gold line, drawn as you scroll. */}
  <div class="relative mx-auto max-w-7xl px-5 pt-16 sm:px-8 lg:pt-24" data-route-stage>
    <div aria-hidden="true" class="absolute bottom-0 left-[2.4rem] top-0 w-px bg-gold/15 sm:left-[3.9rem] lg:left-1/2 lg:-translate-x-1/2">
      <div class="h-full w-full origin-top bg-gold/80" data-route-vline></div>
    </div>

    <p class="relative pb-14 pl-12 text-[0.65rem] font-medium uppercase tracking-eyebrow text-cream/45 sm:pl-16 lg:pl-0 lg:text-center">
      <span aria-hidden="true" class="absolute left-[2.4rem] top-[0.1rem] h-2 w-2 -translate-x-1/2 rounded-full bg-gold/60 sm:left-[3.9rem] lg:left-1/2"></span>
      {t.route.origin}
    </p>

    <ol class="space-y-20 lg:space-y-28">
      {
        t.route.phases.map((phase, i) => (
          <li class="relative" data-route-station>
            <span
              aria-hidden="true"
              class="absolute left-[2.4rem] top-2 h-3 w-3 -translate-x-1/2 rounded-full border border-gold bg-navy sm:left-[3.9rem] lg:left-1/2"
              data-route-dot
            />
            <div
              class:list={[
                'pl-12 sm:pl-16 lg:w-[calc(50%-4.5rem)] lg:pl-0',
                i % 2 === 1 ? 'lg:ml-auto' : 'lg:mr-auto',
              ]}
              data-route-content
            >
              <div class="flex flex-col gap-4 sm:flex-row sm:gap-8">
                <div class="font-display font-medium leading-[0.8] text-gold" style="font-size: clamp(4.5rem, 9vw, 7.5rem);" aria-hidden="true">
                  {phase.num}
                </div>
                <div>
                  <p class="eyebrow">
                    {t.route.phaseLabel} {phase.num} — {phase.duration}
                  </p>
                  <h3 class="mt-3 font-display text-3xl font-semibold leading-tight text-cream sm:text-4xl">{phase.title}</h3>
                  <p class="mt-4 text-sm leading-relaxed text-cream/70 sm:text-base">{phase.summary}</p>
                  <ul class="mt-6 space-y-2.5 text-sm leading-snug text-cream/60">
                    {phase.bullets.map((b) => (
                      <li class="flex gap-3">
                        <span aria-hidden="true" class="mt-[0.65em] h-px w-4 shrink-0 bg-gold/70" />
                        <span>{b}</span>
                      </li>
                    ))}
                  </ul>
                  <p class="mt-6 border-l border-gold pl-4 text-sm leading-snug sm:text-base">
                    <span class="font-medium uppercase tracking-eyebrow text-gold" style="font-size: 0.65rem;">{t.route.deliverableLabel}</span>
                    <span class="mt-1 block text-cream/85">{phase.deliverable}</span>
                  </p>
                </div>
              </div>
            </div>
          </li>
        ))
      }
    </ol>

    <p class="relative pb-4 pl-12 pt-16 text-[0.65rem] font-medium uppercase tracking-eyebrow text-gold sm:pl-16 lg:pl-0 lg:text-center" data-route-dest>
      <span aria-hidden="true" class="absolute bottom-[1.65rem] left-[2.4rem] h-2.5 w-2.5 -translate-x-1/2 rounded-full bg-gold sm:left-[3.9rem] lg:left-1/2"></span>
      <span class="lg:block lg:pt-5">{t.route.destination} <span aria-hidden="true">→</span></span>
    </p>
  </div>

  <div class="mx-auto max-w-7xl px-5 pb-24 pt-16 sm:px-8 lg:pb-28">
    <div class="flex items-center gap-6 border-t border-cream/10 pt-10" data-reveal>
      <span class="gold-rule shrink-0"></span>
      <p class="font-display text-lg font-medium italic text-cream/80 sm:text-xl">{t.route.note}</p>
    </div>
  </div>
</section>
