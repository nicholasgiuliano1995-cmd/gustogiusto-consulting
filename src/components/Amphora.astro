---
// Amphora brand mark — thin gold line art, consistent with the hairline
// rule language of the design system.
interface Props {
  class?: string;
}
const { class: className = 'h-8 w-8' } = Astro.props;
---

<svg
  class={className}
  viewBox="0 0 64 64"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  {/* rim */}
  <path d="M23 6 H41"></path>
  {/* neck + body, symmetric */}
  <path
    d="M26 6 C26 11 25.5 13.5 22.5 16.5 C16.5 22.5 14 27.5 14 33 C14 42.5 20.5 49 27 51 L26 55.5 H38 L37 51 C43.5 49 50 42.5 50 33 C50 27.5 47.5 22.5 41.5 16.5 C38.5 13.5 38 11 38 6"
  ></path>
  {/* foot */}
  <path d="M23 59.5 H41"></path>
  <path d="M26 55.5 L24.5 59.5 M38 55.5 L39.5 59.5"></path>
  {/* handles */}
  <path d="M25.5 10.5 C19 10.5 15.5 15 18 21"></path>
  <path d="M38.5 10.5 C45 10.5 48.5 15 46 21"></path>
  {/* waist detail */}
  <path d="M20 39 C24 41.5 40 41.5 44 39" stroke-width="1.2" opacity="0.7"></path>
</svg>
