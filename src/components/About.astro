---
import type { Locale } from '../i18n';
import { getDict } from '../i18n';

interface Props {
  locale: Locale;
}

const t = getDict(Astro.props.locale);
---

<section id="chi-siamo" class="bg-cream text-ink">
  <div class="mx-auto max-w-7xl px-5 py-24 sm:px-8 lg:py-32">
    <div class="grid gap-12 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-4" data-reveal>
        <p class="eyebrow">{t.about.eyebrow}</p>
        <h2 class="mt-5 font-display font-semibold leading-tight text-navy" style="font-size: clamp(2rem, 4vw, 3.25rem);">
          {t.about.title}
        </h2>
      </div>
      <div class="lg:col-span-7 lg:col-start-6" data-reveal>
        <p class="text-base leading-[1.75] text-ink/80 sm:text-lg">{t.about.body}</p>
      </div>
    </div>

    <ul class="mt-16 grid gap-10 sm:grid-cols-3 lg:mt-24">
      {
        t.about.stats.map((s) => (
          <li data-reveal>
            <span class="gold-rule" />
            <p class="mt-5 font-display text-2xl font-semibold text-navy sm:text-[1.7rem]">{s.line}</p>
            <p class="mt-2 text-sm leading-relaxed text-ink/60">{s.caption}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>
