---
import Base from '../layouts/Base.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
import Hero from './Hero.astro';
import About from './About.astro';
import Route from './Route.astro';
import PhotoBand from './PhotoBand.astro';
import Services from './Services.astro';
import Why from './Why.astro';
import Start from './Start.astro';
import type { Locale } from '../i18n';
import { getDict } from '../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getDict(locale);

// Structured data for search engines (rich results / knowledge panel).
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: 'Gusto Giusto Consulting',
  description: t.meta.home.description,
  url: new URL(t.paths.home, Astro.site).href,
  email: 'gustogiusto@yandex.ru',
  founder: [
    { '@type': 'Person', name: 'Andrey Petrov', jobTitle: 'Import Manager' },
    { '@type': 'Person', name: 'Nicholas Giuliano', jobTitle: 'AIS Russia Representative' },
  ],
  knowsLanguage: ['it', 'es', 'pt', 'ru', 'en'],
  areaServed: ['IT', 'ES', 'PT', 'BR', 'AR', 'CL', 'RU'],
  address: [
    { '@type': 'PostalAddress', addressLocality: 'Moscow', addressCountry: 'RU' },
    { '@type': 'PostalAddress', addressLocality: 'Saint Petersburg', addressCountry: 'RU' },
  ],
};
---

<Base locale={locale} page="home" title={t.meta.home.title} description={t.meta.home.description}>
  <Header locale={locale} page="home" />
  <main>
    <Hero locale={locale} />
    <About locale={locale} />
    <Route locale={locale} />
    <PhotoBand locale={locale} />
    <Services locale={locale} />
    <Why locale={locale} />
    <Start locale={locale} />
  </main>
  <Footer locale={locale} page="home" />

  <script type="application/ld+json" set:html={JSON.stringify(structuredData)} is:inline />
  <script>
    import '../scripts/home';
  </script>
</Base>
