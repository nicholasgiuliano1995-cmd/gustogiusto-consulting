---
import Amphora from './Amphora.astro';
import type { Locale } from '../i18n';
import { alternates, getDict } from '../i18n';

interface Props {
  locale: Locale;
  page: 'home' | 'contact';
}

const { locale, page } = Astro.props;
const t = getDict(locale);
const alts = alternates(page);
const home = t.paths.home;

const anchors = [
  { href: `${home}#metodo`, label: t.nav.method },
  { href: `${home}#consulenza`, label: t.nav.services },
  { href: `${home}#perche`, label: t.nav.why },
  { href: `${home}#iniziare`, label: t.nav.start },
];
---

<header class="fixed inset-x-0 top-0 z-50 border-b border-cream/10 bg-navy/95 backdrop-blur-sm">
  <div class="mx-auto flex h-16 max-w-7xl items-center justify-between gap-6 px-5 sm:px-8 lg:h-20">
    <a href={home} class="group flex items-center gap-3 text-cream transition-colors hover:text-gold">
      <Amphora class="h-9 w-9 shrink-0 text-gold" />
      <span class="flex flex-col">
        <span class="font-display text-base font-semibold leading-none tracking-[0.22em] sm:text-lg">GUSTO&nbsp;GIUSTO</span>
        <span class="mt-1.5 font-sans text-[0.5rem] font-medium uppercase leading-none tracking-[0.5em] text-gold sm:text-[0.55rem]">Consulting</span>
      </span>
    </a>

    <nav aria-label={t.nav.ariaMain} class="hidden items-center gap-8 lg:flex">
      {anchors.map((a) => <a href={a.href} class="nav-link">{a.label}</a>)}
    </nav>

    <div class="flex items-center gap-5 sm:gap-7">
      <nav aria-label={t.nav.ariaLang} class="flex items-center gap-3">
        {
          alts.map((a, i) => (
            <>
              {i > 0 && <span aria-hidden="true" class="h-3 w-px bg-cream/20" />}
              <a
                href={a.href}
                aria-current={a.locale === locale ? 'page' : undefined}
                class:list={[
                  'font-sans text-xs font-medium uppercase tracking-eyebrow transition-colors',
                  a.locale === locale ? 'text-gold' : 'text-cream/55 hover:text-cream',
                ]}
              >
                {a.locale}
              </a>
            </>
          ))
        }
      </nav>
      <a href={t.paths.contact} class="btn-gold hidden !px-5 !py-2.5 sm:inline-flex">{t.nav.cta}</a>
    </div>
  </div>
</header>
