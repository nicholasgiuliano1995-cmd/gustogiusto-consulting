---
import type { Locale } from '../i18n';
import { getDict } from '../i18n';

interface Props {
  locale: Locale;
}

const t = getDict(Astro.props.locale);
---

<section id="iniziare" class="bg-cream text-ink">
  <div class="mx-auto max-w-7xl px-5 py-24 sm:px-8 lg:py-32">
    <div class="max-w-2xl" data-reveal>
      <p class="eyebrow">{t.start.eyebrow}</p>
      <h2 class="mt-5 font-display font-semibold leading-tight text-navy" style="font-size: clamp(2rem, 4vw, 3.25rem);">
        {t.start.title}
      </h2>
    </div>

    <ol class="mt-16 grid gap-12 md:grid-cols-3 lg:mt-20">
      {
        t.start.steps.map((step, i) => (
          <li data-reveal>
            <p class="font-display text-5xl font-medium text-gold" aria-hidden="true">
              {i + 1}
            </p>
            <span class="gold-rule mt-5" />
            <h3 class="mt-5 font-display text-2xl font-semibold text-navy">{step.title}</h3>
            <p class="mt-3 text-sm leading-[1.75] text-ink/70 sm:text-base">{step.body}</p>
          </li>
        ))
      }
    </ol>

    <div class="mt-16 lg:mt-20" data-reveal>
      <a href={t.paths.contact} class="btn-gold-solid">
        {t.start.cta}
        <span aria-hidden="true">→</span>
      </a>
    </div>
  </div>
</section>
